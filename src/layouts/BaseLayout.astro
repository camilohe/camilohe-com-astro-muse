---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Camilo Estevez — Software Engineer in Ottawa, ON, Canada.' } = Astro.props;
const pageTitle = title === 'Home' ? 'Camilo Estevez — Software Engineer' : `${title} · Camilo Estevez`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⌨️</text></svg>" />
    <link rel="alternate" type="application/rss+xml" title="Camilo Estevez — Blog" href="/rss.xml" />
    <style>
      :root {
        --bg: #ffffff;
        --bg-soft: #f6f8fa;
        --fg: #1c1e21;
        --fg-muted: #57606a;
        --border: #d8dee4;
        --accent: #0969da;
        --accent-hover: #0550ae;
        --code-bg: #f6f8fa;
        --radius: 8px;
        --maxw: 720px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0d1117;
          --bg-soft: #161b22;
          --fg: #e6edf3;
          --fg-muted: #8b949e;
          --border: #30363d;
          --accent: #58a6ff;
          --accent-hover: #79c0ff;
          --code-bg: #161b22;
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        line-height: 1.65;
        font-size: 17px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { color: var(--accent-hover); text-decoration: underline; }
      .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 1.25rem; }
      header.site { border-bottom: 1px solid var(--border); }
      header.site .wrap { display: flex; align-items: center; justify-content: space-between; padding-top: 1rem; padding-bottom: 1rem; }
      .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); }
      .brand:hover { text-decoration: none; color: var(--fg); }
      nav.site a { margin-left: 1.25rem; color: var(--fg-muted); font-size: 0.95rem; }
      nav.site a:hover { color: var(--accent); }
      main { padding: 2.5rem 0 4rem; }
      footer.site { border-top: 1px solid var(--border); color: var(--fg-muted); font-size: 0.85rem; }
      footer.site .wrap { padding-top: 1.5rem; padding-bottom: 1.5rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
      h1, h2, h3 { line-height: 1.3; letter-spacing: -0.01em; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 0.25rem; }
      .tagline { color: var(--fg-muted); font-size: 1.15rem; margin: 0 0 1.5rem; }
      .btn-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.5rem 0; }
      .btn {
        display: inline-block; padding: 0.55rem 1.1rem; border: 1px solid var(--border);
        border-radius: var(--radius); color: var(--fg); background: var(--bg-soft); font-size: 0.95rem;
      }
      .btn:hover { text-decoration: none; border-color: var(--accent); color: var(--accent); }
      .card { border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin: 1rem 0; background: var(--bg-soft); }
      .card h3 { margin-top: 0; }
      .meta { color: var(--fg-muted); font-size: 0.9rem; }
      .tag { display: inline-block; font-size: 0.8rem; border: 1px solid var(--border); border-radius: 999px; padding: 0.1rem 0.6rem; margin: 0 0.35rem 0.35rem 0; color: var(--fg-muted); }
      a.tag:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
      .post-list { list-style: none; padding: 0; }
      .post-list li { padding: 1rem 0; border-bottom: 1px solid var(--border); }
      .post-list li:last-child { border-bottom: none; }
      .post-list h3 { margin: 0 0 0.25rem; }
      article.post-body img { max-width: 100%; }
      article.post-body pre {
        border-radius: var(--radius); padding: 1rem; overflow-x: auto;
        border: 1px solid var(--border); font-size: 0.9rem; line-height: 1.5;
      }
      article.post-body code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
      article.post-body :not(pre) > code { background: var(--code-bg); border: 1px solid var(--border); border-radius: 4px; padding: 0.1rem 0.35rem; font-size: 0.88em; }
      article.post-body blockquote { border-left: 3px solid var(--accent); margin: 1.25rem 0; padding: 0.25rem 1rem; color: var(--fg-muted); }
      .sample-notice {
        border: 2px dashed var(--accent); border-radius: var(--radius);
        padding: 1rem 1.25rem; margin: 0 0 1.5rem; background: var(--bg-soft);
      }
      .sample-notice strong { color: var(--accent); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">camilohe.com</a>
        <nav class="site">
          <a href="/about">About</a>
          <a href="/projects">Projects</a>
          <a href="/blog">Blog</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Camilo Estevez · Ottawa, ON</span>
        <span>
          <a href="https://github.com/camilohe">GitHub</a> ·
          <a href="https://www.linkedin.com/in/camilohe">LinkedIn</a> ·
          <a href="https://stackoverflow.com/users/380233/camilo-estevez">Stack Overflow</a> ·
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
